{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__vc_path=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "examples/**"
    }
  },
  "env": {
    "VC_AUDIT_OUTPUT_DIR": "/tmp/vc-audit-out"
  }
}
