{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "env": {
    "VC_AUDIT_OUTPUT_DIR": "/tmp/vc-audit-out",
    "VC_AUDIT_EXAMPLES_DIR": "examples"
  }
}
