# Copy this file to `.env` and fill in the value. `.env` is gitignored.
#
# Only needed for the optional model-assisted peer selection (`--research`).
# Everything else in this tool runs with no credentials at all.
#
# Get a key from https://console.anthropic.com -> API Keys -> Create Key.
# The API is not free; add a few dollars of credit under Billing first.
ANTHROPIC_API_KEY=

# Optional. SEC EDGAR asks callers to identify themselves. Any string shaped
# "Your Name you@example.com" is fine; a working default is used if unset.
SEC_USER_AGENT=
